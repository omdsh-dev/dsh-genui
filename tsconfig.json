      "@deepseek-ai/dsh-client-locale/*": [
        "../../.dsh/source/current/packages/client/locale/lib/types/*"
      ],
      "@deepseek-ai/cordis": [
        "../../.dsh/source/current/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/cordis/*": [
        "../../.dsh/source/current/vendor/cordis/lib/types/*"
