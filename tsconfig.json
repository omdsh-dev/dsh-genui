        "../../.dsh/source/current/packages/core/tools/lib/types/*"
      ],
      "@deepseek-ai/dsh-llm": [
        "../../.dsh/source/current/packages/llm/llm/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-llm/*": [
        "../../.dsh/source/current/packages/llm/llm/lib/types/*"
      ],
      "@deepseek-ai/dsh-session": [
        "../../.dsh/source/current/packages/core/session/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-session/*": [
        "../../.dsh/source/current/packages/core/session/lib/types/*"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../../.dsh/source/current/packages/client/ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots/*": [
