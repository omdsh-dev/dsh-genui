{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src",
    "outDir": "lib",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../../.dsh/source/current/packages/client/ui-primitives/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives/*": [
        "../../.dsh/source/current/packages/client/ui-primitives/lib/types/*"
      ],
      "@deepseek-ai/dsh-system-prompt": [
        "../../.dsh/source/current/packages/core/system-prompt/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-system-prompt/*": [
        "../../.dsh/source/current/packages/core/system-prompt/lib/types/*"
      ],
      "@deepseek-ai/dsh-invariants": [
        "../../.dsh/source/current/packages/runtime-diagnostics/invariants/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-invariants/*": [
        "../../.dsh/source/current/packages/runtime-diagnostics/invariants/lib/types/*"
      ],
      "@deepseek-ai/dsh-tools": [
        "../../.dsh/source/current/packages/core/tools/lib/types/index.d.ts"
      ],
