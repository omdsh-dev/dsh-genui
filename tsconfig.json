      ],
      "@deepseek-ai/dsh-client-ui-tool/*": [
        "../../.dsh/source/current/packages/client/ui-tool/lib/types/*"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "../../.dsh/source/current/packages/client/runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/*": [
        "../../.dsh/source/current/packages/client/runtime/lib/types/*"
