  {
    "id": "demo-quiz",
    "category": "proof",
    "note": "Harness proof: quiz grades locally (correct/feedback/explanation) — no engine, no model turn.",
    "zh": {
      "title": "dsh-ui 小测",
      "gap": 12,
      "items": [
        {
          "type": "quiz",
          "question": "一段 dsh-ui 围栏渲染出来的界面，由谁绘制？",
          "id": "demo-quiz-1",
          "options": [
            { "label": "浏览器里手写的 HTML 模板" },
            { "label": "dsh-genui 的白名单渲染器", "correct": true, "feedback": "对：围栏 JSON 被映射成白名单组件。" },
            { "label": "模型生成的一张截图" }
          ],
          "explanation": "渲染器把每个节点映射为 DOM。作答在本地判分，不会触发模型回合。"
        },
        { "type": "text", "size": "caption", "content": "作答、判分与解释全部在本地完成。" }
      ]
    },
    "en": {
      "title": "dsh-ui quiz",
      "gap": 12,
      "items": [
        {
          "type": "quiz",
          "question": "Who paints an interface rendered from a dsh-ui fence?",
          "id": "demo-quiz-1",
          "options": [
            { "label": "Hand-written HTML templates in the browser" },
            { "label": "The dsh-genui whitelist renderer", "correct": true, "feedback": "Right: the fence JSON is mapped onto whitelisted components." },
            { "label": "A screenshot generated by the model" }
          ],
          "explanation": "The renderer maps every node to DOM. Grading happens locally and never triggers a model turn."
        },
        { "type": "text", "size": "caption", "content": "Answers, grading and explanations all happen client-side." }
      ]
    }
  },
  {
    "id": "demo-mermaid",
    "category": "proof",
    "note": "Harness proof: heavy engine node, ~3.4 MB mermaid bundle, deferred until the user asks to mount it.",
    "zh": {
      "title": "一条回答的处理链路（mermaid）",
      "gap": 12,
      "items": [
        { "type": "text", "size": "caption", "content": "mermaid 节点会按需加载独立引擎；这才是渲染器真正下载的负担。" },
        {
          "type": "mermaid",
          "code": "graph LR\n  A[模型回复] --> B[dsh-ui 围栏]\n  B --> C[guard 校验]\n  C --> D[白名单组件]\n  D --> E[可交互界面]"
        }
      ]
    },
    "en": {
      "title": "How one reply becomes an interface (mermaid)",
      "gap": 12,
      "items": [
        { "type": "text", "size": "caption", "content": "A mermaid node pulls its own engine bundle on demand — the renderer's real download cost." },
        {
          "type": "mermaid",
          "code": "graph LR\n  A[Model reply] --> B[dsh-ui fence]\n  B --> C[guard validation]\n  C --> D[Whitelisted components]\n  D --> E[Interactive interface]"
        }
      ]
    }
  },
