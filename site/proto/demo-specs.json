          "details": [
            [{ "type": "keyvalue", "pairs": [{ "key": "负责人", "value": "平台组" }, { "key": "SLO", "value": "P95 < 150ms" }] }],
            null,
            [{ "type": "text", "size": "caption", "content": "展开行可以放任意白名单组件" }]
          ]
        },
        { "type": "text", "size": "caption", "content": "排序、筛选、展开全部在浏览器内完成；没有网络请求，也没有模型回合。" }
      ]
    },
    "en": {
      "title": "Delivery metrics · last 8 weeks (sample data)",
      "gap": 12,
      "items": [
        {
          "type": "row",
          "wrap": true,
          "items": [
            { "type": "badge", "label": "Sample data", "tone": "accent" },
            { "type": "badge", "label": "Click a header to sort", "tone": "success" },
            { "type": "badge", "label": "Local filter" }
          ]
        },
        { "type": "input", "label": "Filter services", "placeholder": "Type to filter the table instantly", "id": "demo-table-filter" },
        {
          "type": "table",
          "columns": ["Service", "P95 (ms)", "Uptime", "Load", "Status"],
