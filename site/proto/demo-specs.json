  {
    "id": "demo-table",
    "category": "proof",
    "note": "Harness proof: sortable/filterable table with badge + bar + details — no engine bundle needed.",
    "zh": {
      "title": "交付指标 · 近 8 周（示例数据）",
      "gap": 12,
      "items": [
        {
          "type": "row",
          "wrap": true,
          "items": [
            { "type": "badge", "label": "示例数据", "tone": "accent" },
            { "type": "badge", "label": "点击表头排序", "tone": "success" },
            { "type": "badge", "label": "本地筛选" }
          ]
        },
        { "type": "input", "label": "筛选服务", "placeholder": "输入关键字即时过滤下表", "id": "demo-table-filter" },
        {
          "type": "table",
          "columns": ["服务", "P95 (ms)", "可用率", "负载", "状态"],
          "types": ["text", "num", "num", "bar", "badge"],
          "filter": "demo-table-filter",
          "rows": [
            ["API 网关", 128, "99.96", 62, "正常"],
            ["搜索", 190, "99.82", 78, "关注"],
            ["推荐", 250, "99.41", 91, "偏高"]
