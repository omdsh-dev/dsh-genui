            null,
            [{ "type": "text", "size": "caption", "content": "An expanded row can hold any whitelisted component" }]
          ]
        },
        { "type": "text", "size": "caption", "content": "Sorting, filtering and expanding all happen client-side — no network request, no model turn." }
      ]
    }
  },
