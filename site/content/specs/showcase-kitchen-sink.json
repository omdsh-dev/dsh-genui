{
  "id": "showcase-kitchen-sink",
  "category": "showcase",
  "note": "全要素 bento：stat hero 为唯一焦点，其余容器/数据/交互各出现一次（table、donut、tabs、accordion、badges、copy、breadcrumb）。示例数据，含少量仓库事实。",
  "zh": {
    "title": "一块围栏能装下多少东西",
    "gap": 14,
    "items": [
      {
        "type": "grid",
        "cols": 4,
        "items": [
          {
            "type": "card",
            "span": 2,
            "eyebrow": "一眼",
            "title": "本地优先",
            "items": [
              {
                "type": "stat",
                "size": "hero",
                "label": "排序 / 过滤 / 判卷 / 折叠",
                "value": "0",
                "delta": "次往返"
              },
              {
                "type": "text",
                "size": "muted",
                "content": "界面自己能做的，不让模型再做一遍。"
              }
            ]
          },
          {
            "type": "card",
            "eyebrow": "预算",
            "title": "节点上限",
            "items": [
              {
                "type": "progress",
                "variant": "ring",
                "value": 38,
                "target": 100,
                "valueLabel": "38 / 200"
              }
            ]
          },
          {
            "type": "card",
            "eyebrow": "引擎",
            "title": "按需加载",
            "items": [
              {
                "type": "list",
                "items": [
                  "mermaid",
                  "three.js",
                  "maplibre",
                  "echarts"
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "grid",
        "cols": 3,
        "items": [
          {
            "type": "card",
            "span": 2,
            "eyebrow": "数据",
            "title": "一行一个模块",
            "items": [
              {
                "type": "table",
                "columns": [
                  "模块",
                  "本周合入",
                  "进度",
                  "状态"
                ],
                "types": [
                  "text",
                  "num",
                  "bar",
                  "badge"
                ],
                "rows": [
                  [
                    "渲染器 runtime",
                    "12",
                    "86",
                    "正常"
                  ],
                  [
                    "组件词汇",
                    "9",
                    "74",
                    "正常"
                  ],
                  [
                    "文档",
                    "7",
                    "61",
                    "关注"
                  ],
                  [
                    "性能预算",
                    "3",
                    "47",
                    "风险"
                  ]
                ]
              }
            ]
          },
          {
            "type": "card",
            "eyebrow": "占比",
            "title": "三类归属",
            "items": [
              {
                "type": "chart",
                "kind": "donut",
                "data": [
                  {
                    "label": "渲染",
                    "value": 21
                  },
                  {
                    "label": "质量",
                    "value": 12
                  },
                  {
                    "label": "分发",
                    "value": 7
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "grid",
        "cols": 2,
        "items": [
          {
            "type": "tabs",
            "tabs": [
              {
                "label": "说明",
                "items": [
                  {
                    "type": "text",
                    "size": "body",
                    "content": "标签页在本地切换，页面位置不变。"
                  },
                  {
                    "type": "list",
                    "items": [
                      "结论先行",
                      "证据随后"
                    ]
                  }
                ]
              },
              {
                "label": "规格",
                "items": [
                  {
                    "type": "code",
                    "lang": "json",
                    "code": "{\"type\":\"grid\",\"cols\":4,\"items\":[{\"type\":\"stat\",\"size\":\"hero\",\"label\":\"本地优先\",\"value\":\"0\"}]}"
                  }
                ]
              }
            ]
          },
          {
            "type": "accordion",
            "items": [
              {
                "title": "两级目录",
                "items": [
                  {
                    "type": "file-tree",
                    "items": [
                      {
                        "name": "src",
                        "type": "dir",
                        "children": [
                          {
                            "name": "spec.ts",
                            "type": "file"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "title": "结构化原文",
                "items": [
                  {
                    "type": "json",
                    "value": {
                      "type": "callout",
                      "tone": "info",
                      "content": "..."
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "wrap": true,
        "items": [
          {
            "type": "badge",
            "label": "MIT",
            "tone": "success"
          },
          {
            "type": "badge",
            "label": "zh / en",
            "tone": "accent"
          },
          {
            "type": "copy",
            "label": "复制围栏",
            "text": "{\"items\":[{\"type\":\"stat\",\"label\":\"本地优先\",\"value\":\"0\"}]}"
          },
          {
            "type": "breadcrumb",
            "items": [
              "组件",
              "容器",
              "看板"
            ]
          }
        ]
      }
    ]
  },
